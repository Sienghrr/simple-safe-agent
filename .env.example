# ── LLM Configuration ─────────────────────────────────────
# Supported models: llama3.2:3b, qwen3:4b, or any Ollama model with tool-calling
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# ── Database ──────────────────────────────────────────────
DATABASE_PATH=student_assistant.db

# ── Agent Safety ──────────────────────────────────────────
MAX_TOOL_CALLS=10
